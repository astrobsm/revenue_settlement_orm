# ============================================================
# Central Theatre Revenue — environment
# ------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit a filled-in copy.
# Every secret here is a key to real money.
# ============================================================

# --- Database -------------------------------------------------
# Its own database. Central Theatre Revenue does not write to ORM's schema.
#
# LOCAL POSTGRES: both variables are the same connection string.
DATABASE_URL="postgresql://postgres:password@localhost:5432/central_theatre_revenue?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/central_theatre_revenue?schema=public"

# --- SUPABASE -------------------------------------------------
# Supabase is ordinary PostgreSQL, so the schema and every migration apply
# unchanged. Three things differ, and getting any of them wrong is expensive.
#
# 1. TWO CONNECTION STRINGS, NOT ONE.
#
#    DATABASE_URL  the POOLED connection, port 6543 (pgbouncer). Used at
#                  runtime, because a deployed app opens far more connections
#                  than Postgres tolerates directly.
#    DIRECT_URL    the DIRECT connection, port 5432. Used for migrations.
#                  pgbouncer runs in transaction mode and cannot carry the
#                  session-level statements a migration issues — CREATE TRIGGER,
#                  advisory locks, the migration lock. Pointing DIRECT_URL at
#                  the pooler gives migrations that appear to hang, then fail
#                  halfway, which is the worst possible outcome for a schema.
#
#    DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#    DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
#
#    Keep ?pgbouncer=true on the pooled URL. Without it Prisma prepares
#    statements pgbouncer cannot reuse, and queries fail intermittently under
#    load — which is to say, on a busy theatre list rather than in testing.
#
# 2. THE anon KEY IS PUBLIC, AND SUPABASE PUBLISHES EVERY TABLE.
#
#    Supabase runs PostgREST over the public schema and exposes every table in
#    it. The anon key is not a secret; it is meant to be embedded in browser
#    JavaScript. Without row level security, that would publish every patient
#    name, charge description, invoice and payment in this database to anyone
#    who asks.
#
#    The 20260818000200_lock_down_postgrest migration closes this: RLS is
#    enabled on every table with NO policies, and anon/authenticated are
#    revoked all access including on tables created in future. This application
#    reaches the database only through Prisma as the schema owner, so it is
#    unaffected.
#
#    DO NOT write permissive RLS policies to "make things work". If something
#    cannot read the database, it is not meant to.
#
# 3. NEVER PUT THE service_role KEY IN ANYTHING A BROWSER LOADS.
#
#    It bypasses RLS entirely and is equivalent to the database password. This
#    application does not use the Supabase SDK at all and needs neither key —
#    they are listed here only so nobody adds them casually.
#
# SUPABASE_URL=""
# SUPABASE_ANON_KEY=""          # public by design; not used by this app
# SUPABASE_SERVICE_ROLE_KEY=""  # equivalent to the DB password; server-side only

# --- Auth -----------------------------------------------------
NEXTAUTH_URL="http://localhost:3100"
# openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Encryption of bank account numbers (§14, §42) ------------
# 32-byte key, base64. Rotating this without re-encrypting makes stored account
# numbers unreadable — read lib/crypto.ts before you change it.
FIELD_ENCRYPTION_KEY=""

# --- ORM integration (§38) ------------------------------------
# READ-ONLY. Central Theatre Revenue pulls patient, booking, theatre,
# anaesthesia, pharmacy and consumable data; it never writes clinical records.
ORM_BASE_URL="http://localhost:3000"
ORM_SERVICE_TOKEN=""

# --- Payment providers (§9) -----------------------------------
# No provider is hard-coded. Configure only the ones this hospital uses; an
# unconfigured provider is simply unavailable rather than broken.
#
# The DESK provider is always available and needs no credentials: it is the
# cash/POS revenue desk, and its payments are ATTESTED rather than
# GATEWAY_VERIFIED. See lib/payments/states.ts for what that distinction buys.

PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Set only if this hospital uses Paystack's native split settlement.
PAYSTACK_SPLIT_CODE=""

FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
# Flutterwave signs webhooks with a value you choose in its dashboard.
FLUTTERWAVE_WEBHOOK_HASH=""

# --- Financial policy (§20, §21) ------------------------------
# ON_FULL_PAYMENT  allocate only when the invoice is fully paid (recommended)
# PRO_RATA         allocate proportionally as each part payment arrives
ALLOCATION_TIMING="ON_FULL_PAYMENT"

# Basis points. 750 = 7.5% VAT. 0 where hospital services are exempt.
DEFAULT_TAX_BASIS_POINTS="0"

# Discount above this share of a charge needs a second person's approval (§22).
# 1000 basis points = 10%.
DISCOUNT_APPROVAL_THRESHOLD_BASIS_POINTS="1000"

# --- Receipt verification (§26) -------------------------------
RECEIPT_VERIFY_BASE_URL="http://localhost:3100/verify"

# --- Seeded administrator accounts (§24, §25, §42) ------------
# TWO SEPARATE ACCOUNTS, for two separate people. Not bureaucracy:
#
#   SUPER ADMINISTRATOR    system administration; holds every permission, which
#                          is why it should be used rarely and is fully audited.
#   FINANCE ADMINISTRATOR  configures accounts, allocation rules, beneficiaries
#                          and prices — and CANNOT confirm a payment or approve
#                          a refund.
#
# Giving one person both recreates the concentration §25 forbids, and the role
# review would reject the pair.
#
# Neither account is created unless BOTH its email and password are set here.
# A default administrator with a known password is how a financial system is
# owned on its first day. Minimum 12 characters.
#
# After seeding: ENROL MFA on each. Until then every configuration route
# refuses them with MFA_REQUIRED — that is a live control, not a reminder.
# Then change these passwords: they have been sat in an environment variable.

SEED_SUPERADMIN_EMAIL=""
SEED_SUPERADMIN_PASSWORD=""

SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
