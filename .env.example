# ============================================================
# Central Theatre Revenue — environment
# ------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit a filled-in copy.
# Every secret here is a key to real money.
# ============================================================

# --- Database -------------------------------------------------
# Its own database. Central Theatre Revenue does not write to ORM's schema.
DATABASE_URL="postgresql://postgres:password@localhost:5432/central_theatre_revenue?schema=public"

# --- Auth -----------------------------------------------------
NEXTAUTH_URL="http://localhost:3100"
# openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Encryption of bank account numbers (§14, §42) ------------
# 32-byte key, base64. Rotating this without re-encrypting makes stored account
# numbers unreadable — read lib/crypto.ts before you change it.
FIELD_ENCRYPTION_KEY=""

# --- ORM integration (§38) ------------------------------------
# READ-ONLY. Central Theatre Revenue pulls patient, booking, theatre,
# anaesthesia, pharmacy and consumable data; it never writes clinical records.
ORM_BASE_URL="http://localhost:3000"
ORM_SERVICE_TOKEN=""

# --- Payment providers (§9) -----------------------------------
# No provider is hard-coded. Configure only the ones this hospital uses; an
# unconfigured provider is simply unavailable rather than broken.
#
# The DESK provider is always available and needs no credentials: it is the
# cash/POS revenue desk, and its payments are ATTESTED rather than
# GATEWAY_VERIFIED. See lib/payments/states.ts for what that distinction buys.

PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Set only if this hospital uses Paystack's native split settlement.
PAYSTACK_SPLIT_CODE=""

FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
# Flutterwave signs webhooks with a value you choose in its dashboard.
FLUTTERWAVE_WEBHOOK_HASH=""

# --- Financial policy (§20, §21) ------------------------------
# ON_FULL_PAYMENT  allocate only when the invoice is fully paid (recommended)
# PRO_RATA         allocate proportionally as each part payment arrives
ALLOCATION_TIMING="ON_FULL_PAYMENT"

# Basis points. 750 = 7.5% VAT. 0 where hospital services are exempt.
DEFAULT_TAX_BASIS_POINTS="0"

# Discount above this share of a charge needs a second person's approval (§22).
# 1000 basis points = 10%.
DISCOUNT_APPROVAL_THRESHOLD_BASIS_POINTS="1000"

# --- Receipt verification (§26) -------------------------------
RECEIPT_VERIFY_BASE_URL="http://localhost:3100/verify"
